root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,cc,cxx,c}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{cmake,txt}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.{json,jsonc,yaml,yml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false